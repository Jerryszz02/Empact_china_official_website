# Copy to .env locally; never commit real values. Run npm run setup:local for private local secrets.
PAYLOAD_SECRET=
CMS_URL=http://127.0.0.1:4321
DATABASE_URL=file:../../.data/cms.db
MEDIA_DIR=../../.data/media
RUNTIME_DIR=../../.data/site
SITE_URL=https://empact.cn
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=4321
# SMTP is optional for local preview. Without it contact responds 503.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
CONTACT_RECEIVER_NAME=
CONTACT_ENABLED=false
CONTACT_RETENTION_DAYS=30
