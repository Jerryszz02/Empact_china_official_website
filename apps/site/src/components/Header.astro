---
import { businesses, pages, projects, pathFor } from "@/lib/content";
const chatCircle = projects.find((item) => item.slug === "chatcircle");
const youthBusinesses = businesses.filter((item) => item.segment === "youth");
const corporateBusinesses = businesses.filter(
  (item) => item.segment === "corporate",
);
const youthPage = pages.find((item) => item.slug === "youth");
const corporatePage = pages.find((item) => item.slug === "corporate");
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Empact China 首页">
    <img
      src="/brand/empact-logo-blue.png"
      alt="Empact China"
      width="1600"
      height="591"
    />
  </a>
  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
  >
    <span class="menu-label">菜单</span>
    <span class="menu-icon" aria-hidden="true">
      ☰
    </span>
  </button>
  <nav id="site-navigation" class="site-nav" aria-label="主导航">
    <div class="nav-group">
      <a
        class="nav-parent"
        href={youthPage ? pathFor(youthPage) : "/youth/"}
        aria-expanded={youthBusinesses.length > 0 ? "false" : undefined}
        aria-controls={youthBusinesses.length > 0 ? "nav-youth" : undefined}
      >
        青少年项目
      </a>
      {youthBusinesses.length > 0 && (
        <div id="nav-youth" class="nav-dropdown">
          {youthBusinesses.map((item) => (
            <a href={pathFor(item)}>{item.title}</a>
          ))}
        </div>
      )}
    </div>
    <div class="nav-group">
      <a
        class="nav-parent"
        href={corporatePage ? pathFor(corporatePage) : "/corporate/"}
        aria-expanded={corporateBusinesses.length > 0 ? "false" : undefined}
        aria-controls={
          corporateBusinesses.length > 0 ? "nav-corporate" : undefined
        }
      >
        企业服务
      </a>
      {corporateBusinesses.length > 0 && (
        <div id="nav-corporate" class="nav-dropdown">
          {corporateBusinesses.map((item) => (
            <a href={pathFor(item)}>{item.title}</a>
          ))}
        </div>
      )}
    </div>
    <a href="/about/">关于 Empact</a>
    {chatCircle && <a href={pathFor(chatCircle)}>ChatCircle</a>}
    <a class="nav-contact" href="/contact/">
      咨询与合作 <span aria-hidden="true">↗</span>
    </a>
    <button class="nav-close" type="button" aria-label="关闭导航">
      关闭
    </button>
  </nav>
</header>
<script>
  document.documentElement.classList.add("js");
  const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#site-navigation");
  const close = document.querySelector<HTMLButtonElement>(".nav-close");
  const toggles = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      ".nav-parent[aria-controls]",
    ),
  ];
  function closeDropdowns() {
    toggles.forEach((button) => {
      button.setAttribute("aria-expanded", "false");
      document
        .getElementById(button.getAttribute("aria-controls")!)
        ?.classList.remove("is-open");
    });
  }
  function closeMenu() {
    closeDropdowns();
    menu?.setAttribute("aria-expanded", "false");
    nav?.classList.remove("is-open");
  }
  menu?.addEventListener("click", () => {
    const wasOpen = menu.getAttribute("aria-expanded") === "true";
    closeMenu();
    if (!wasOpen) {
      menu.setAttribute("aria-expanded", "true");
      nav?.classList.add("is-open");
    }
  });
  close?.addEventListener("click", () => {
    closeMenu();
    menu?.focus();
  });
  const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
  toggles.forEach((link) => {
    const group = link.closest<HTMLElement>(".nav-group")!;
    const dropdown = document.getElementById(
      link.getAttribute("aria-controls")!,
    )!;
    function openDropdown() {
      closeDropdowns();
      link.setAttribute("aria-expanded", "true");
      dropdown.classList.add("is-open");
    }
    group.addEventListener("pointerenter", (event) => {
      if (hover.matches && event.pointerType !== "touch") openDropdown();
    });
    group.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "touch") {
        link.setAttribute("aria-expanded", "false");
        dropdown.classList.remove("is-open");
      }
    });
    let touchActivation = false;
    link.addEventListener("pointerdown", (event) => {
      touchActivation = event.pointerType === "touch";
    });
    link.addEventListener("pointercancel", () => {
      touchActivation = false;
    });
    link.addEventListener("focus", () => {
      if (hover.matches && !touchActivation) openDropdown();
    });
    link.addEventListener("keydown", (event) => {
      touchActivation = false;
      if (event.key === "ArrowDown") {
        event.preventDefault();
        openDropdown();
        dropdown.querySelector<HTMLAnchorElement>("a")?.focus();
      }
    });
    link.addEventListener("click", (event) => {
      const isTouch =
        touchActivation ||
        (event instanceof PointerEvent && event.pointerType === "touch");
      touchActivation = false;
      if (
        (isTouch || !hover.matches) &&
        link.getAttribute("aria-expanded") !== "true"
      ) {
        event.preventDefault();
        openDropdown();
      }
    });
    group.addEventListener("focusout", (event) => {
      if (
        !(event.relatedTarget instanceof Node) ||
        !group.contains(event.relatedTarget)
      ) {
        link.setAttribute("aria-expanded", "false");
        dropdown.classList.remove("is-open");
      }
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const openDropdown = toggles.find(
      (button) => button.getAttribute("aria-expanded") === "true",
    );
    if (openDropdown) {
      openDropdown.focus();
      closeDropdowns();
    } else if (menu?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      menu.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !nav?.contains(event.target) &&
      !menu?.contains(event.target)
    )
      closeMenu();
  });
  nav?.addEventListener("focusout", (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !nav.contains(event.relatedTarget) &&
      !menu?.contains(event.relatedTarget)
    )
      closeMenu();
  });
</script>
