---
import { socialLinks } from "@/lib/social-links";
const accounts = [socialLinks.wechatYouth, socialLinks.wechatChina];
---

{accounts.map((account) => (
  <dialog
    id={account.dialogId}
    class="wechat-dialog"
    aria-labelledby={`${account.dialogId}-title`}
    aria-describedby={`${account.dialogId}-description`}
  >
    <form method="dialog">
      <button class="wechat-close" aria-label="关闭公众号二维码" autofocus>
        ×
      </button>
    </form>
    <span class="wechat-platform">微信公众号</span>
    <h2 id={`${account.dialogId}-title`}>{account.name}</h2>
    {account.qrCode ? (
      <img
        class="wechat-qr"
        src={account.qrCode}
        alt={`${account.name}公众号关注二维码`}
        width="258"
        height="258"
      />
    ) : (
      <div class="wechat-qr wechat-qr-placeholder" aria-label="二维码待更新" />
    )}
    <p id={`${account.dialogId}-description`}>
      {account.qrCode ? "使用微信扫一扫，关注公众号" : "公众号二维码待更新"}
    </p>
  </dialog>
))}

<script>
  document.addEventListener("click", (event) => {
    const trigger =
      event.target instanceof Element
        ? event.target.closest<HTMLButtonElement>("button[data-wechat-dialog]")
        : null;
    if (!trigger?.dataset.wechatDialog) return;
    const dialog = document.getElementById(trigger.dataset.wechatDialog);
    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
    dialog.showModal();
    document.documentElement.classList.add("wechat-dialog-open");
  });

  document
    .querySelectorAll<HTMLDialogElement>(".wechat-dialog")
    .forEach((dialog) => {
      dialog.addEventListener("wheel", (event) => event.stopPropagation(), {
        passive: true,
      });
      dialog.addEventListener("close", () => {
        document.documentElement.classList.remove("wechat-dialog-open");
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        ) {
          dialog.close();
        }
      });
    });
</script>

<style>
  :global(html.wechat-dialog-open) {
    overflow: hidden;
  }
  .wechat-dialog {
    width: min(24rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 2.5rem 1.5rem 1.5rem;
    border: 0;
    border-radius: 0.75rem;
    background: #fff;
    color: var(--blue);
    text-align: center;
    box-shadow: 0 1rem 4rem rgb(0 0 0 / 20%);
  }
  .wechat-dialog::backdrop {
    background: rgb(0 0 0 / 55%);
  }
  .wechat-close {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    font-size: 1.75rem;
    line-height: 1;
  }
  .wechat-platform {
    color: var(--secondary);
    font-size: 0.875rem;
  }
  .wechat-dialog h2 {
    margin: 0.5rem 0 1.25rem;
    font-size: 1.5rem;
  }
  .wechat-qr {
    display: block;
    width: min(258px, 100%);
    aspect-ratio: 1;
    margin: 0 auto;
  }
  .wechat-qr-placeholder {
    border: 1px dashed var(--dark-line);
    background: var(--paper);
  }
  .wechat-dialog p {
    margin: 1rem 0 0;
    color: var(--secondary);
    font-size: 0.875rem;
  }
</style>
