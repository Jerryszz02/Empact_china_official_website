---
import type { Entry } from "@empact/content/schema";
import CaseCard from "@/components/CaseCard.astro";
import { groupCases } from "@/lib/case-layout";

interface Props {
  cases: Entry[];
  businessSlug: string;
}

const { cases, businessSlug } = Astro.props;
const groups = groupCases(cases, businessSlug);
const grouped = groups.length > 1;
---

{grouped && (
  <nav class="case-group-nav" aria-label="案例分类">
    {groups.map((group) => (
      <a href={`#cases-${group.id}`}>{group.title}</a>
    ))}
  </nav>
)}
{groups.map((group) => (
  <div class:list={["case-group", { "case-group-labelled": grouped }]}>
    {grouped && (
      <h3 id={`cases-${group.id}`} class="case-group-title">
        {group.title}
      </h3>
    )}
    <div
      class:list={[
        "case-grid",
        { "case-grid-single": group.entries.length === 1 },
      ]}
    >
      {group.entries.map((entry) => (
        <CaseCard entry={entry} grouped={grouped} />
      ))}
    </div>
  </div>
))}
