---
import { snapshot, news, pathFor } from "@/lib/content";
import { socialLinks } from "@/lib/social-links";
const updates = [...news].sort((a, b) =>
  (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""),
);
const company = snapshot.company;
const socials = Object.values(socialLinks);
---

<footer class="site-footer">
  <div class="footer-brand">
    <a href="/" aria-label="Empact China 首页">
      <img
        src="/brand/empact-logo-tagline-white.png"
        alt="Empact China"
        width="1080"
        height="483"
      />
    </a>
  </div>

  {company.approved && (
    <div class="footer-office footer-office-china">
      <span class="footer-office-label">中国 · 上海</span>
      {company.address && (
        <span class="footer-office-address">{company.address}</span>
      )}
      <a href="mailto:maggie.yang@empact.sg">maggie.yang@empact.sg</a>
    </div>
  )}

  <div class="footer-office footer-office-singapore">
    <span class="footer-office-label">新加坡</span>
    <span class="footer-office-address">
      Enabling Village
      <br />
      20 Lengkok Bahru, <span class="footer-address-unit">Vista #04-02</span>
      <br />
      Singapore 159053
    </span>
    <a
      href="https://portal.empact.sg/empact-general-enquiry"
      target="_blank"
      rel="noopener noreferrer"
    >
      联系 Empact 新加坡
    </a>
  </div>

  <nav class="footer-socials" aria-label="社交媒体">
    {socials.map((social) => (
      <a
        href={social.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${social.platform}：${social.name}`}
        title={`${social.platform}：${social.name}`}
      >
        {social.platform === "小红书" ? (
          <img
            class="footer-social-icon"
            src="/brand/xiaohongshu-white.svg"
            alt=""
            aria-hidden="true"
            width="24"
            height="24"
          />
        ) : social.platform === "LinkedIn" ? (
          <svg
            class="footer-social-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="currentColor"
          >
            <path d="M20.45 2H3.55C2.7 2 2 2.67 2 3.5v17c0 .83.7 1.5 1.55 1.5h16.9c.85 0 1.55-.67 1.55-1.5v-17c0-.83-.7-1.5-1.55-1.5ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z" />
          </svg>
        ) : social.platform === "Facebook" ? (
          <svg
            class="footer-social-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            fill="currentColor"
          >
            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.9 3.77-3.9 1.09 0 2.23.19 2.23.19v2.45h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z" />
          </svg>
        ) : (
          <svg
            class="footer-social-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M10 3C5.58 3 2 5.91 2 9.5c0 2.08 1.2 3.94 3.09 5.13L4.3 17l2.83-1.42c.91.27 1.87.42 2.87.42 4.42 0 8-2.91 8-6.5S14.42 3 10 3Z"
              fill="currentColor"
            />
            <circle cx="7" cy="8" r="1" fill="var(--blue)" />
            <circle cx="12" cy="8" r="1" fill="var(--blue)" />
            <path
              d="M16 10c-3.6 0-6.5 2.35-6.5 5.25S12.4 20.5 16 20.5c.8 0 1.58-.12 2.3-.33l2.3 1.13-.65-1.9c1.55-.96 2.55-2.48 2.55-4.15C22.5 12.35 19.6 10 16 10Z"
              fill="currentColor"
              stroke="var(--blue)"
              stroke-width="1"
            />
            <circle cx="13.5" cy="14" r=".85" fill="var(--blue)" />
            <circle cx="18" cy="14" r=".85" fill="var(--blue)" />
          </svg>
        )}
        <span>{social.name}</span>
      </a>
    ))}
  </nav>

  {updates.length > 0 && (
    <nav class="footer-content" aria-label="新闻">
      <span>新闻</span>
      {updates.map((item) => (
        <a href={pathFor(item)}>{item.title}</a>
      ))}
    </nav>
  )}

  <div class="footer-bottom">
    <nav class="footer-links" aria-label="页脚导航">
      <a href="/about/">关于我们</a>
      <a href="/contact/">联系 Empact</a>
      <a href="/privacy/">隐私政策</a>
      <a href="/terms/">使用条款</a>
      <a href="/admin" rel="nofollow">
        后台管理
      </a>
    </nav>
    <p class="footer-meta">
      © {new Date().getFullYear()} {company.name}
    </p>
    {company.approved && (
      <div class="footer-legal">
        <span>{company.legalName}</span>
        {company.icp && (
          <a href="https://beian.miit.gov.cn/" rel="noopener noreferrer">
            {company.icp}
          </a>
        )}
        {company.publicSecurityRecord && (
          <a href="https://beian.mps.gov.cn/" rel="noopener noreferrer">
            {company.publicSecurityRecord}
          </a>
        )}
      </div>
    )}
  </div>
</footer>

<style>
  .site-footer {
    display: grid;
    grid-template-columns: auto minmax(0, 0.8fr) minmax(0, 1fr) minmax(
        0,
        1.8fr
      );
    grid-template-areas:
      "brand china singapore socials"
      "news news news news"
      "bottom bottom bottom bottom";
    align-items: start;
    gap: 0.4rem 1.6rem;
    min-height: 216px;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    background: var(--blue);
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .footer-brand {
    grid-area: brand;
  }
  .footer-brand img {
    display: block;
    width: 11rem;
    height: auto;
  }
  .footer-office {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .footer-office-china {
    grid-area: china;
  }
  .footer-office-singapore {
    grid-area: singapore;
  }
  .footer-address-unit {
    white-space: nowrap;
  }
  .footer-office-label {
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .footer-office a {
    text-decoration: underline;
  }
  .footer-socials {
    grid-area: socials;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 0.5rem 1rem;
    min-width: 0;
  }
  .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .footer-social-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
  }
  .footer-content {
    grid-area: news;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    min-width: 0;
  }
  .footer-content a {
    overflow-wrap: anywhere;
  }
  .footer-content span {
    opacity: 0.7;
  }
  .footer-bottom {
    grid-area: bottom;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 0.5rem;
    font-size: 0.6875rem;
    line-height: 1.45;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .footer-links a,
  .footer-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
  }
  .footer-meta {
    margin: 0;
  }
  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }
  @media (max-width: 72em) {
    .site-footer {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "brand brand"
        "china singapore"
        "socials socials"
        "news news"
        "bottom bottom";
      gap: 0.25rem 0.85rem;
      min-height: 268px;
      padding-block: 0.5rem;
      font-size: 0.75rem;
    }
    .footer-brand img {
      width: clamp(5rem, 27vw, 8.5rem);
    }
    .footer-socials {
      gap: 0.4rem 0.85rem;
      padding-block: 0.4rem;
    }
    .footer-bottom {
      align-items: flex-start;
      gap: 0.2rem 0.8rem;
      padding-top: 0.4rem;
    }
    .footer-links {
      column-gap: 0.6rem;
    }
    .footer-links a,
    .footer-legal a {
      min-height: 24px;
    }
  }
</style>
