---
import { snapshot, projects, news, pathFor } from "@/lib/content";
const updates = [...news].sort((a, b) =>
  (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""),
);
---

<footer class="site-footer">
  <div class="footer-brand">
    <a href="/" aria-label="Empact China 首页">
      <img
        src="/brand/empact-logo-tagline-white.png"
        alt="Empact China"
        width="1080"
        height="483"
      />
    </a>
    <p>{snapshot.company.description}</p>
  </div>
  <div class="footer-links">
    <a href="/about/">关于我们</a>
    <a href="/contact/">联系 Empact</a>
    <a href="/privacy/">隐私政策</a>
    <a href="/terms/">使用条款</a>
  </div>
  {(projects.length > 0 || updates.length > 0) && (
    <nav class="footer-content" aria-label="项目与新闻">
      {projects.length > 0 && (
        <div>
          <span>项目</span>
          {projects.map((item) => (
            <a href={pathFor(item)}>{item.title}</a>
          ))}
        </div>
      )}
      {updates.length > 0 && (
        <div>
          <span>新闻</span>
          {updates.map((item) => (
            <a href={pathFor(item)}>{item.title}</a>
          ))}
        </div>
      )}
    </nav>
  )}
  <p class="footer-meta">
    © {new Date().getFullYear()} {snapshot.company.name}
  </p>
  {snapshot.company.approved && (
    <div class="footer-legal">
      <span>{snapshot.company.legalName}</span>
      {snapshot.company.address && (
        <address>{snapshot.company.address}</address>
      )}
      {snapshot.company.icp && (
        <a href="https://beian.miit.gov.cn/" rel="noopener noreferrer">
          {snapshot.company.icp}
        </a>
      )}
      {snapshot.company.publicSecurityRecord && (
        <a href="https://beian.mps.gov.cn/" rel="noopener noreferrer">
          {snapshot.company.publicSecurityRecord}
        </a>
      )}
    </div>
  )}
</footer>

<style>
  .footer-legal address {
    font-style: normal;
    overflow-wrap: anywhere;
  }
  .footer-content {
    grid-column: 1 / -1;
    display: grid;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  .footer-content div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
  }
  .footer-content span {
    opacity: 0.7;
  }
  .footer-content a {
    overflow-wrap: anywhere;
  }
</style>
