---
import { snapshot } from "@/lib/content";
---

<footer class="site-footer">
  <div class="footer-brand">
    <span class="wordmark-mark" aria-hidden="true">
      ◎
    </span>
    <span>
      empact<span class="wordmark-cn">中国</span>
    </span>
    <p>{snapshot.company.description}</p>
  </div>
  <div class="footer-links">
    <a href="/about/">关于我们</a>
    <a href="/contact/">联系 Empact</a>
    <a href="/privacy/">隐私政策</a>
    <a href="/terms/">使用条款</a>
  </div>
  <p class="footer-meta">
    © {new Date().getFullYear()} {snapshot.company.name}
  </p>
  {snapshot.company.approved && (
    <div class="footer-legal">
      <span>{snapshot.company.legalName}</span>
      {snapshot.company.icp && (
        <a href="https://beian.miit.gov.cn/" rel="noopener noreferrer">
          {snapshot.company.icp}
        </a>
      )}
      {snapshot.company.publicSecurityRecord && (
        <a href="https://beian.mps.gov.cn/" rel="noopener noreferrer">
          {snapshot.company.publicSecurityRecord}
        </a>
      )}
    </div>
  )}
</footer>
