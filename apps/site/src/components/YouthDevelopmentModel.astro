---
const dimensions = [
  { title: "复合身份认同力", copy: "理解自己，在多元文化中找到位置" },
  { title: "技术人文主义力", copy: "善用技术，关照人的需求与责任" },
  { title: "敏捷跨文化诠释力", copy: "理解文化差异，找到沟通的方法" },
  { title: "分布式协作领导力", copy: "连接不同角色，共同推动行动" },
  { title: "问题生态诊断力", copy: "看见问题关联，找到行动的切入点" },
  { title: "价值理性平衡力", copy: "权衡价值与影响，作出有依据的选择" },
];
const traits = ["开放性", "反思性", "韧性", "复杂性取向", "价值扎根"];
const polar = (radius: number, angle: number) => {
  const radians = (angle * Math.PI) / 180;
  return [500 + radius * Math.cos(radians), 500 + radius * Math.sin(radians)];
};
const sectors = dimensions.map((_, index) => {
  const start = -120 + index * 60;
  const end = start + 60;
  const outerStart = polar(484, start);
  const outerEnd = polar(484, end);
  const innerEnd = polar(280, end);
  const innerStart = polar(280, start);
  return `M ${outerStart} A 484 484 0 0 1 ${outerEnd} L ${innerEnd} A 280 280 0 0 0 ${innerStart} Z`;
});
---

<section class="youth-model" aria-label="六维发展模型图解">
  <div class="model-visual">
    <svg
      class="model-rings"
      viewBox="0 0 1000 1000"
      aria-hidden="true"
      focusable="false"
    >
      {sectors.map((path, index) => (
        <path class={`sector sector-${index % 3}`} d={path} />
      ))}
      <circle class="outer-ring" cx="500" cy="500" r="490" />
      <circle class="inner-ring" cx="500" cy="500" r="265" />
      <circle class="core-circle" cx="500" cy="500" r="132" />
      {dimensions.map((_, index) => {
        const [x, y] = polar(377, -90 + index * 60);
        return (
          <text class="mobile-ring-number" x={x} y={y}>
            0{index + 1}
          </text>
        );
      })}
    </svg>
    <div class="model-core-copy">
      <span class="core-label">核心</span>
      <strong>主体性</strong>
      <span class="core-support">自主选择 · 主动行动</span>
      <span class="core-support">持续反思</span>
    </div>
    <div class="trait-heading">内在特质</div>
    <div class="traits" aria-label="五项内在特质">
      {traits.map((trait, index) => (
        <span class={`trait trait-${index + 1}`}>{trait}</span>
      ))}
    </div>
    <ol class="model-items" aria-label="六项发展能力">
      {dimensions.map((dimension, index) => (
        <li class={`model-item item-${index + 1}`}>
          <span class="item-number">0{index + 1}</span>
          <div>
            <h3>{dimension.title}</h3>
            <p>
              {dimension.copy.split("，").map((line, lineIndex) => (
                <span>
                  {line}
                  {lineIndex === 0 && <span class="copy-comma">，</span>}
                </span>
              ))}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .youth-model {
    --model-navy: var(--blue, #125284);
    --model-teal: #d4eeee;
    --model-purple: #e6def5;
    --model-coral: #f9dfe3;
    color: var(--model-navy);
    max-width: 55rem;
    margin: 2rem auto 0;
  }
  .model-visual {
    position: relative;
    aspect-ratio: 1;
  }
  .model-rings {
    display: block;
    width: 100%;
    height: auto;
  }
  .sector {
    stroke: #fff;
    stroke-width: 10;
  }
  .sector-0 {
    fill: var(--model-teal);
  }
  .sector-1 {
    fill: var(--model-purple);
  }
  .sector-2 {
    fill: var(--model-coral);
  }
  .outer-ring {
    fill: none;
    stroke: var(--model-navy);
    stroke-width: 6;
  }
  .inner-ring {
    fill: #fff;
    stroke: #9481d5;
    stroke-width: 4;
  }
  .core-circle {
    fill: var(--model-navy);
  }
  .model-core-copy {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    gap: 0.15em;
    width: 26%;
    text-align: center;
    color: #fff;
  }
  .core-label {
    color: #b9e9e7;
    font-size: 0.75rem;
  }
  .model-core-copy strong {
    font-size: clamp(1.65rem, 2.8vw, 2.3rem);
    line-height: 1.5;
  }
  .core-support {
    font-size: clamp(0.65rem, 1vw, 0.85rem);
    line-height: 1.6;
  }
  .trait-heading {
    position: absolute;
    left: 50%;
    top: 33%;
    transform: translate(-50%, -50%);
    font-size: 0.75rem;
    color: #6c549c;
  }
  .trait {
    position: absolute;
    transform: translate(-50%, -50%);
    padding: 0.3em 0.65em;
    background: #eee7f7;
    border-radius: 2em;
    font-size: clamp(0.75rem, 1.2vw, 0.95rem);
    white-space: nowrap;
    line-height: 1.5;
  }
  .trait-1 {
    left: 50%;
    top: 29%;
  }
  .trait-2 {
    left: 70%;
    top: 43.5%;
  }
  .trait-3 {
    left: 62.3%;
    top: 67%;
  }
  .trait-4 {
    left: 37.7%;
    top: 67%;
  }
  .trait-5 {
    left: 30%;
    top: 43.5%;
  }
  .model-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .model-item {
    position: absolute;
    width: 25%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  .item-number {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.25em;
  }
  .model-item h3 {
    font-size: clamp(0.88rem, 1.48vw, 1.2rem);
    line-height: 1.5;
    margin: 0 0 0.3em;
  }
  .model-item p {
    font-size: clamp(0.75rem, 1.05vw, 0.9rem);
    line-height: 1.75;
    margin: 0;
    color: #426475;
  }
  .model-item p > span {
    display: block;
  }
  .copy-comma {
    display: none;
  }
  .item-1 {
    left: 50%;
    top: 12%;
  }
  .item-2 {
    left: 81.8%;
    top: 31.5%;
  }
  .item-3 {
    left: 81.8%;
    top: 68.5%;
  }
  .item-4 {
    left: 50%;
    top: 88%;
  }
  .item-5 {
    left: 18.2%;
    top: 68.5%;
  }
  .item-6 {
    left: 18.2%;
    top: 31.5%;
  }
  .mobile-ring-number {
    display: none;
  }
  @media (max-width: 700px) {
    .youth-model {
      margin-top: 1.5rem;
    }
    .model-visual {
      aspect-ratio: auto;
    }
    .model-rings {
      max-width: 27rem;
      margin: auto;
    }
    .model-core-copy {
      top: 0;
      left: 0;
      width: 100%;
      height: min(100cqi, 27rem);
      transform: none;
      place-content: center;
    }
    .model-visual {
      container-type: inline-size;
    }
    .core-circle {
      r: 225px;
    }
    .model-core-copy strong {
      font-size: 1.7rem;
    }
    .core-label {
      font-size: 0.7rem;
    }
    .core-support {
      font-size: 0.75rem;
    }
    .mobile-ring-number {
      display: block;
      text-anchor: middle;
      dominant-baseline: middle;
      font-size: 58px;
      font-weight: 700;
      fill: var(--model-navy);
    }
    .trait-heading {
      position: static;
      transform: none;
      font-size: 0.85rem;
      margin: 1.2rem 0 0.5rem;
      text-align: center;
    }
    .traits {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    .trait {
      position: static;
      transform: none;
      font-size: 0.85rem;
    }
    .model-items {
      display: grid;
      gap: 0.7rem;
    }
    .model-item {
      position: static;
      width: auto;
      transform: none;
      text-align: left;
      display: grid;
      grid-template-columns: 2rem 1fr;
      gap: 0.5rem;
      padding: 1rem;
      border-radius: 0.8rem;
      border-left: 0.25rem solid #2cb3b9;
      background: var(--model-teal);
    }
    .item-2,
    .item-5 {
      background: var(--model-purple);
      border-color: #9481d5;
    }
    .item-3,
    .item-6 {
      background: var(--model-coral);
      border-color: #ed7383;
    }
    .item-number {
      margin-top: 0.15em;
      font-size: 0.9rem;
    }
    .model-item h3 {
      font-size: 1rem;
    }
    .model-item p {
      font-size: 0.9rem;
    }
    .model-item p > span,
    .copy-comma {
      display: inline;
    }
  }
</style>
