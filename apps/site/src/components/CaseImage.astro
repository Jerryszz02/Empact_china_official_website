---
import type { Entry } from "@empact/content/schema";
import { isPreviewMode, mediaById } from "@/lib/content";

interface Props {
  entry: Entry;
  class?: string;
}

const { entry, class: className = "" } = Astro.props;
const media = mediaById(entry.imageId);
---

{media ? (
  <figure class={`case-image ${className}`}>
    <img
      src={`/media/${media.filename}`}
      alt={media.alt}
      width={media.width}
      height={media.height}
      loading="lazy"
    />
  </figure>
) : (
  isPreviewMode() && (
    <div
      class={`case-image case-image-placeholder ${className}`}
      aria-label="项目图片待补充"
    >
      <span>项目图片待补充</span>
    </div>
  )
)}
