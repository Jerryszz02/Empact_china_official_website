---
import { Image } from "astro:assets";
import { mediaById, snapshot } from "@/lib/content";
import { resolveOfficeGallery } from "@/lib/office-gallery";
import officePhoto from "@/assets/recruitment/office.jpg";
import brandPhoto from "@/assets/recruitment/office-brand.jpg";

const images = resolveOfficeGallery(snapshot, mediaById) ?? [
  {
    src: officePhoto,
    alt: "Empact 办公空间的工位、绿植与窗边区域",
    caption: "Empact 办公空间",
    width: 1440,
    height: 1080,
  },
  {
    src: brandPhoto,
    alt: "办公室的蓝色 Empact 品牌墙与展示柜一角",
    caption: "办公室一角",
    width: 960,
    height: 1280,
  },
];
---

{images.length > 0 && (
  <section
    class="section recruitment-office"
    aria-labelledby="office-title"
    data-office-gallery
  >
    <div class="recruitment-section-heading">
      <span class="eyebrow">A glimpse of everyday life</span>
      <h2 id="office-title">一起工作的地方</h2>
      <p>认识 Empact，也从日常的工作空间开始。</p>
    </div>
    <div
      id="office-photos"
      class="recruitment-office-photos"
      data-office-track
      data-many={images.length > 2 ? "true" : "false"}
      role="group"
      aria-label="办公空间照片"
    >
      {images.map((image) => (
        <figure>
          {typeof image.src === "string" ? (
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={image.src}
              alt={image.alt}
              width={image.width}
              widths={[480, 640, 960, 1440]}
              sizes="(max-width: 640px) calc(100vw - 2.2rem), 60vw"
              format="webp"
              quality={80}
              loading="lazy"
            />
          )}
          <figcaption>{image.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="office-gallery-controls" data-office-controls hidden>
      <button
        type="button"
        aria-label="上一张办公空间照片"
        aria-controls="office-photos"
        data-office-previous
      >
        ←
      </button>
      <span>左右滑动，看看我们的日常</span>
      <button
        type="button"
        aria-label="下一张办公空间照片"
        aria-controls="office-photos"
        data-office-next
      >
        →
      </button>
    </div>
  </section>
)}

<script>
  document
    .querySelectorAll<HTMLElement>("[data-office-gallery]")
    .forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-office-track]")!;
      const controls = root.querySelector<HTMLElement>(
        "[data-office-controls]",
      )!;
      const previous = root.querySelector<HTMLButtonElement>(
        "[data-office-previous]",
      )!;
      const next = root.querySelector<HTMLButtonElement>("[data-office-next]")!;
      const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

      function update() {
        const overflow = track.scrollWidth > track.clientWidth + 1;
        controls.hidden = !overflow;
        if (overflow) track.tabIndex = 0;
        else track.removeAttribute("tabindex");
        previous.disabled = track.scrollLeft <= 1;
        next.disabled =
          track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
      }

      function move(direction: number) {
        const card = track.querySelector<HTMLElement>("figure");
        if (!card) return;
        const step =
          card.getBoundingClientRect().width +
          parseFloat(getComputedStyle(track).columnGap);
        track.scrollBy({
          left: direction * step,
          behavior: reducedMotion.matches ? "instant" : "smooth",
        });
      }

      previous.addEventListener("click", () => move(-1));
      next.addEventListener("click", () => move(1));
      track.addEventListener("scroll", update, { passive: true });
      track.addEventListener("keydown", (event) => {
        if (controls.hidden || !["ArrowLeft", "ArrowRight"].includes(event.key))
          return;
        event.preventDefault();
        move(event.key === "ArrowRight" ? 1 : -1);
      });
      new ResizeObserver(update).observe(track);
      update();
    });
</script>
