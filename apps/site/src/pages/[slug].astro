---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/lib/content";
export function getStaticPaths() {
  return pages
    .filter(
      (entry) =>
        ![
          "home",
          "youth",
          "corporate",
          "school",
          "community",
          "about",
          "contact",
          "privacy",
          "terms",
        ].includes(entry.slug),
    )
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
---

<BaseLayout title={entry.title} description={entry.summary}>
  <section class="page-hero">
    <span class="eyebrow">Empact China</span>
    <h1>{entry.title}</h1>
    <p class="page-summary">{entry.summary}</p>
  </section>
  <section class="content-wrap">
    <article class="prose" set:html={entry.bodyHtml} />
  </section>
</BaseLayout>
