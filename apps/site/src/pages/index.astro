---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CaseImage from "@/components/CaseImage.astro";
import {
  businesses,
  pageBySlug,
  pathFor,
  projects,
  news,
  cases,
  byId,
} from "@/lib/content";
const home = pageBySlug("home");
const youth = pageBySlug("youth");
const corporate = pageBySlug("corporate");
const youthServices = businesses.filter((item) => item.segment === "youth");
const corporateServices = businesses.filter(
  (item) => item.segment === "corporate",
);
const chatCircle = projects.find((item) => item.slug === "chatcircle");
const featuredProjects = projects.filter(
  (item) => item.featured && item.id !== chatCircle?.id,
);
const featuredCases = cases.filter(
  (item) => item.featured && byId(item.parentId),
);
const updates = news
  .filter((item) => item.featured)
  .sort((a, b) => (b.publishedAt ?? "").localeCompare(a.publishedAt ?? ""))
  .slice(0, 3);
---

<BaseLayout title={home?.title ?? "Empact 中国"} description={home?.summary}>
  <section class="hero">
    <div class="hero-copy-block">
      <span class="eyebrow hero-eyebrow">Empact China / Social innovation</span>
      <h1 class="hero-title">
        <span>
          Empowering{" "}
          <svg class="hero-star" viewBox="0 0 40 40" aria-hidden="true">
            <path d="M20 2V38 M2 20H38 M7 7L33 33 M7 33L33 7" />
          </svg>
        </span>
        <span>
          Greater{" "}
          <svg class="hero-arrow" viewBox="0 0 80 80" aria-hidden="true">
            <path d="M8 72L72 8 M40 8H72V40" />
          </svg>
        </span>
        <span>
          Empact<span class="hero-period">.</span>
        </span>
      </h1>
      <div class="hero-support">
        <div>
          <p class="hero-subtitle">赋能更大的影响力</p>
          <p class="hero-copy">{home?.summary}</p>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/youth/">
            探索青少年项目 <span aria-hidden="true">↗</span>
          </a>
          <a class="button" href="/corporate/">
            了解企业服务 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="hero-index" aria-hidden="true">
      <span>YOUTH</span>
      <span>ORGANISATIONS</span>
      <span>SOCIAL INNOVATION</span>
    </div>
  </section>
  <section class="business-matrix pathways section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Two ways in</span>
        <h2>从你的关注出发</h2>
      </div>
      <div class="matrix-intro prose" set:html={home?.bodyHtml ?? ""} />
    </div>
    <div class="matrix-grid">
      <div class="matrix-column">
        <span class="eyebrow">For youth, families & schools</span>
        <h3>{youth?.title ?? "青少年项目"}</h3>
        <p>{youth?.summary}</p>
        {youthServices.map((item) => (
          <a class="matrix-row" href={pathFor(item)}>
            <span>{item.title}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="matrix-link" href="/youth/">
          查看青少年项目 →
        </a>
      </div>
      <div class="matrix-column">
        <span class="eyebrow">For organisations</span>
        <h3>{corporate?.title ?? "企业服务"}</h3>
        <p>{corporate?.summary}</p>
        {corporateServices.map((item) => (
          <a class="matrix-row" href={pathFor(item)}>
            <span>{item.title}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a class="matrix-link" href="/corporate/">
          查看企业服务 →
        </a>
      </div>
    </div>
  </section>
  {featuredProjects.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <h2>精选项目</h2>
      </div>
      <div class="service-list">
        {featuredProjects.map((item) => (
          <div class="service-item">
            <a href={pathFor(item)}>{item.title}</a>
            <span>{item.summary}</span>
          </div>
        ))}
      </div>
    </section>
  )}
  {featuredCases.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <h2>实践记录</h2>
      </div>
      <div class="case-grid">
        {featuredCases.map((item) => (
          <article class="case-card">
            <CaseImage entry={item} />
            <div class="case-card-copy">
              <h3>
                <a href={`${pathFor(byId(item.parentId)!)}#${item.slug}`}>
                  {item.title}
                </a>
              </h3>
              <p>{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
  {chatCircle && (
    <section class="circle-band">
      <div class="circle-band-inner">
        <div>
          <span class="eyebrow coral-label">ChatCircle</span>
          <h2>{chatCircle.title}</h2>
          <p>{chatCircle.summary}</p>
        </div>
        <a class="button" href={pathFor(chatCircle)}>
          了解公益项目 <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  )}
  {updates.length > 0 && (
    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Updates</span>
          <h2>最新动态</h2>
        </div>
      </div>
      <div class="service-list">
        {updates.map((item) => (
          <div class="service-item">
            <a href={pathFor(item)}>{item.title}</a>
            <time datetime={item.publishedAt}>
              {item.publishedAt?.slice(0, 10)}
            </time>
          </div>
        ))}
      </div>
    </section>
  )}
  <section class="section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Start a conversation</span>
        <h2>
          从一次
          <br />
          交流开始
        </h2>
      </div>
      <a class="button button-primary" href="/contact/">
        咨询与合作 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
