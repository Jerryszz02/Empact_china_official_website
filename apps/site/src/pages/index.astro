---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pageBySlug } from "@/lib/content";
const home = pageBySlug("home");
---

<BaseLayout
  title={home?.title ?? "Empact 中国"}
  description={home?.summary}
  bodyClass="motion-home"
>
  <div class="motion-stage motion-home" data-motion-stage>
    <div
      class="motion-background"
      data-motion-background
      aria-hidden="true"
    ></div>
    <canvas
      class="motion-canvas"
      data-motion-canvas
      aria-hidden="true"
    ></canvas>
    <section
      id="brand"
      class="motion-scene motion-scene-brand"
      data-motion-scene
    >
      <span
        class="motion-logo motion-logo-brand"
        data-motion-logo
        aria-hidden="true"
      >
        <img
          src="/brand/empact-logo-tagline-white.png"
          alt=""
          width="1080"
          height="483"
        />
      </span>
      <div class="motion-scene-content">
        <p class="motion-tagline">empowering greater impact</p>
        <h1>赋能更大的影响力</h1>
      </div>
      <span class="motion-scene-index" aria-hidden="true">
        01 / 03
      </span>
    </section>
    <section
      id="pathways"
      class="motion-scene motion-scene-pathways pathways"
      data-motion-scene
    >
      <div class="motion-scene-content">
        <p class="eyebrow">Two ways in</p>
        <h2>从你的关注出发</h2>
        <div class="motion-pathways">
          <a class="motion-pathway" href="/youth/">
            <span class="motion-pathway-turn">
              <span class="motion-pathway-face motion-pathway-front">
                <span class="eyebrow">For youth, families & schools</span>
                <strong>青少年项目</strong>
                <span class="motion-arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
              <span
                class="motion-pathway-face motion-pathway-back"
                aria-hidden="true"
              >
                <span class="eyebrow">For youth, families & schools</span>
                <strong>青少年项目</strong>
                <span class="motion-arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
            </span>
          </a>
          <a class="motion-pathway" href="/corporate/">
            <span class="motion-pathway-turn">
              <span class="motion-pathway-face motion-pathway-front">
                <span class="eyebrow">For organisations</span>
                <strong>企业服务</strong>
                <span class="motion-arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
              <span
                class="motion-pathway-face motion-pathway-back"
                aria-hidden="true"
              >
                <span class="eyebrow">For organisations</span>
                <strong>企业服务</strong>
                <span class="motion-arrow" aria-hidden="true">
                  ↗
                </span>
              </span>
            </span>
          </a>
        </div>
      </div>
      <span class="motion-scene-index" aria-hidden="true">
        02 / 03
      </span>
    </section>
    <section
      id="conversation"
      class="motion-scene motion-scene-conversation"
      data-motion-scene
    >
      <span
        class="motion-logo motion-logo-conversation"
        data-motion-logo
        aria-hidden="true"
      >
        <img
          src="/brand/empact-logo-tagline-white.png"
          alt=""
          width="1080"
          height="483"
        />
      </span>
      <div class="motion-scene-content">
        <p class="eyebrow">Start a conversation</p>
        <h2>从一次交流开始</h2>
        <a class="button motion-button" href="/contact/">
          咨询与合作 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <span class="motion-scene-index" aria-hidden="true">
        03 / 03
      </span>
    </section>
  </div>
</BaseLayout>

<script>
  import "@/lib/home-motion";
</script>

<style>
  :global(body.motion-home) {
    --motion-blue: var(--blue);
    --motion-paper: var(--paper);
    background: var(--motion-blue);
    color: var(--motion-paper);
  }
  :global(body.motion-home.motion-js .site-header) {
    position: fixed;
    z-index: 5;
    top: calc(0.75rem + var(--motion-banner-space, 0px));
    left: 50%;
    transform: translateX(-50%);
    width: min(88rem, calc(100% - 3rem));
    margin: 0;
  }
  :global(body.motion-home.motion-js .preview-bar) {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 7;
  }
  .motion-stage {
    position: relative;
    min-height: 300svh;
  }

  /* Shared fixed blue background with a paper layer driven by scroll. */
  .motion-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    background: var(--motion-paper);
    opacity: 0;
    pointer-events: none;
  }
  :global(html.motion-live) .motion-background {
    display: block;
  }

  .motion-scene {
    min-height: 100svh;
    min-height: 100dvh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vh, 2.5rem);
    padding: max(8rem, var(--motion-header-space, 6rem))
      clamp(1.5rem, 6vw, 6rem) clamp(3rem, 8vh, 7rem);
    overflow: visible;
    text-align: center;
  }
  .motion-scene-brand,
  .motion-scene-conversation {
    background-color: var(--motion-blue);
    color: var(--motion-paper);
  }
  .motion-scene-pathways {
    background-color: var(--motion-paper);
    color: var(--motion-blue);
    align-items: flex-start;
    justify-content: flex-start;
    text-align: left;
    padding-top: clamp(8rem, 23vh, 14rem);
  }
  :global(html.motion-live) .motion-scene {
    background-color: transparent;
  }

  .motion-scene-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 70rem;
    min-width: 0;
    opacity: var(--scene-fade, 1);
    transition: opacity 140ms linear;
  }
  .motion-scene-index {
    position: absolute;
    z-index: 3;
    right: clamp(1.5rem, 6vw, 6rem);
    bottom: clamp(3rem, 8vh, 7rem);
    font:
      0.75rem/1.5 Arial,
      sans-serif;
    letter-spacing: 0.12em;
    opacity: var(--scene-fade, 1);
    transition: opacity 140ms linear;
  }
  .motion-scene:focus-within .motion-scene-content,
  .motion-scene:focus-within .motion-scene-index {
    opacity: 1 !important;
  }

  /* Real brand mark, cropped to remove the baked-in tagline. */
  .motion-logo {
    position: relative;
    z-index: 3;
    display: block;
    flex: 0 0 auto;
    aspect-ratio: 1080 / 373;
    overflow: hidden;
    opacity: 1;
    transition: opacity 200ms linear;
  }
  .motion-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .motion-logo-brand {
    width: 70vw;
  }
  .motion-logo-conversation {
    width: min(46vw, 34rem);
  }
  :global(html.motion-live) .motion-logo {
    opacity: 0;
  }

  .motion-scene h1 {
    font:
      400 clamp(0.9rem, 1.2vw, 1.05rem)/1.6 Arial,
      "PingFang SC",
      sans-serif;
    margin: 0.65rem 0 0;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .motion-scene h2 {
    font:
      400 clamp(2.4rem, 5.5vw, 6rem)/1.18 Arial,
      "PingFang SC",
      sans-serif;
    margin: 0.2em 0 0.3em;
    overflow-wrap: anywhere;
  }
  .motion-tagline {
    margin: 0 auto;
    font:
      400 clamp(1rem, 1.5vw, 1.25rem)/1.6 Arial,
      sans-serif;
    letter-spacing: 0.16em;
    text-transform: none;
  }
  .motion-scene p {
    max-width: 42rem;
  }

  .motion-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }
  .motion-canvas[hidden] {
    display: none;
  }

  .motion-pathways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 6vw, 6rem);
    margin-top: 2.2rem;
    width: 100%;
    max-width: 70rem;
  }
  .motion-pathway {
    --pathway-height: 11rem;
    --pathway-depth: calc(var(--pathway-height) / 2);
    position: relative;
    display: block;
    min-width: 0;
    min-height: var(--pathway-height);
    border-top: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    perspective: 60rem;
    perspective-origin: center center;
  }
  .motion-pathway-turn {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    transform: translateZ(calc(-1 * var(--pathway-depth)));
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }
  .motion-pathway-face {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.1rem 1.25rem;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .motion-pathway-front {
    transform: rotateX(0deg) translateZ(var(--pathway-depth));
    background: var(--motion-paper);
    color: var(--motion-blue);
  }
  .motion-pathway-back {
    transform: rotateX(90deg) translateZ(var(--pathway-depth));
    background: var(--motion-blue);
    color: var(--motion-paper);
  }
  .motion-pathway strong {
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    font-weight: 400;
  }
  .motion-pathway .eyebrow {
    overflow-wrap: anywhere;
  }
  .motion-arrow {
    position: absolute;
    right: 1.1rem;
    top: 1rem;
    font-size: 1.6rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .motion-pathway:hover .motion-pathway-turn {
      transform: translateZ(calc(-1 * var(--pathway-depth))) rotateX(-90deg);
    }
  }
  .motion-pathway:focus-visible .motion-pathway-turn {
    transform: translateZ(calc(-1 * var(--pathway-depth))) rotateX(-90deg);
  }

  .motion-button {
    margin-top: 1.4rem;
    background: var(--motion-paper);
    color: var(--motion-blue);
    border-color: var(--motion-paper);
    border-radius: 3rem;
  }
  .motion-scene-conversation {
    padding-bottom: 13vh;
  }
  .motion-scene-conversation .motion-scene-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  :global(body.motion-home .site-footer) {
    position: relative;
    z-index: 3;
    background: var(--blue);
  }
  :global(html.motion-overflow) .motion-logo {
    position: static;
    transform: none;
    width: min(75%, 28rem);
    margin: 1rem auto 2rem;
  }
  :global(html.motion-overflow) .motion-scene {
    justify-content: center;
    gap: 1rem;
  }
  :global(html.motion-overflow) .motion-scene-conversation {
    align-items: center;
  }

  @media (max-width: 600px) {
    :global(body.motion-home.motion-js .site-header) {
      top: calc(0.5rem + var(--motion-banner-space, 0px));
      width: calc(100% - 2rem);
    }
    .motion-scene {
      padding: max(7rem, var(--motion-header-space, 6rem)) 1.5rem 4rem;
    }
    .motion-scene-pathways {
      padding-top: max(23vh, var(--motion-header-space, 6rem));
    }
    .motion-logo-brand {
      width: min(92vw, 30rem);
    }
    .motion-logo-conversation {
      width: min(76vw, 22rem);
    }
    .motion-pathways {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .motion-pathway {
      --pathway-height: 9rem;
    }
    .motion-scene-index {
      right: 1.5rem;
      bottom: 1.5rem;
    }
    .motion-scene-conversation {
      padding-bottom: 17vh;
    }
    .motion-scene h2 {
      font-size: clamp(2.4rem, 11vw, 2.9rem);
    }
  }
  @media (max-width: 600px) {
    :global(body.motion-home .wordmark img) {
      width: min(9.4rem, 38vw);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
    .motion-canvas {
      display: none;
    }
    .motion-pathway-turn {
      transform: translateZ(calc(-1 * var(--pathway-depth))) !important;
      transition: none;
    }
    :global(html.motion-live) .motion-logo {
      opacity: 1;
    }
  }
</style>
