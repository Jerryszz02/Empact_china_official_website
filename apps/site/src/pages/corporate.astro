---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { businesses, pageBySlug, pathFor } from "@/lib/content";
const entry = pageBySlug("corporate");
const services = businesses.filter((item) => item.segment === "corporate");
---

<BaseLayout
  title={entry?.title ?? "企业服务"}
  description={
    entry?.summary ?? "帮助组织理解人、支持人，把共同的价值落在日常工作里。"
  }
>
  <section class="page-hero">
    <a class="back-link" href="/">
      <span aria-hidden="true">←</span> 返回首页
    </a>
    <span class="eyebrow">For organisations</span>
    <h1>{entry?.title ?? "企业服务"}</h1>
    <p class="page-summary">
      {entry?.summary ?? "从一个真实问题开始，找到组织可以实践的下一步。"}
    </p>
  </section>
  <section class="content-wrap">
    {services.length > 0 && (
      <div class="service-list service-list-spaced">
        {services.map((item) => (
          <div class="service-item">
            <a href={pathFor(item)}>{item.title}</a>
            <span>{item.summary}</span>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
