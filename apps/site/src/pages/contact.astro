---
import { inquirySegments } from "@empact/content/inquiry";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { snapshot, businesses, pageBySlug } from "@/lib/content";
const enabled =
  snapshot.company.contactEnabled &&
  snapshot.company.approved &&
  snapshot.company.privacyApproved &&
  snapshot.mode === "production";
const fallback = snapshot.company.approved ? snapshot.company.email : "";
const entry = pageBySlug("contact");
---

<BaseLayout title={entry?.title ?? "联系 Empact"} description={entry?.summary}>
  <section class="contact-layout">
    <div class="contact-intro">
      <span class="eyebrow">Start a conversation</span>
      <h1>
        从一次
        <br />
        交流开始
        <span class="contact-period" aria-hidden="true">
          。
        </span>
      </h1>
      <p>{entry?.summary}</p>
      <div class="prose" set:html={entry?.bodyHtml ?? ""} />
      {fallback && (
        <p>
          <a href={`mailto:${fallback}`}>{fallback}</a>
        </p>
      )}
    </div>
    <form
      class="contact-form"
      method="post"
      action="/api/contact"
      data-contact-form
    >
      <h2>咨询与合作</h2>
      <p class="form-help">
        带 * 为必填。留下一个联系方式即可，其余信息可按实际情况补充。
      </p>
      <fieldset>
        <legend>01 / 咨询方向</legend>
        <label for="segment">业务范围 *</label>
        <select id="segment" name="segment" required>
          <option value="">请选择业务范围</option>
          {inquirySegments.map((item) => (
            <option value={item.value}>{item.label}</option>
          ))}
        </select>
        <label for="business">子业务 *</label>
        <select id="business" name="business" required>
          <option value="">请选择子业务</option>
          {inquirySegments
            .filter((item) => item.value !== "other")
            .map((segment) => (
              <optgroup label={segment.label}>
                {businesses
                  .filter((item) => item.segment === segment.value)
                  .map((item) => (
                    <option value={item.id} data-segment={item.segment}>
                      {item.title}
                    </option>
                  ))}
              </optgroup>
            ))}
          <option value="other">其他／暂不确定</option>
        </select>
      </fieldset>
      <fieldset>
        <legend>02 / 联系信息</legend>
        <label for="name">如何称呼您 *</label>
        <input
          id="name"
          name="name"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="姓名或称呼"
        />
        <label for="contact">联系方式 *</label>
        <input
          id="contact"
          name="contact"
          required
          minlength="3"
          maxlength="160"
          placeholder="邮箱、电话或微信号，填写一种即可"
        />
        <label for="organization">机构名称（选填）</label>
        <input
          id="organization"
          name="organization"
          maxlength="160"
          autocomplete="organization"
          placeholder="企业、学校或机构名称"
        />
        <label for="role">职位（选填）</label>
        <input
          id="role"
          name="role"
          maxlength="100"
          autocomplete="organization-title"
        />
      </fieldset>
      <fieldset>
        <legend>03 / 合作需求</legend>
        <label for="message">需求说明 *</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="3000"
          placeholder="请用至少 10 个字介绍项目背景、目前的需求或想解决的问题。"
        ></textarea>
        <label for="goal">合作目标（选填）</label>
        <textarea
          id="goal"
          name="goal"
          maxlength="1000"
          placeholder="希望通过这次合作带来什么改变？"
        ></textarea>
        <div class="contact-fields-grid">
          <div>
            <label for="location">地点（选填）</label>
            <input
              id="location"
              name="location"
              maxlength="120"
              placeholder="城市或线上"
            />
          </div>
          <div>
            <label for="timeline">预计时间（选填）</label>
            <input
              id="timeline"
              name="timeline"
              maxlength="160"
              placeholder="开始及结束时间，或尚未确定"
            />
          </div>
          <div>
            <label for="participants">人数（选填）</label>
            <input
              id="participants"
              name="participants"
              maxlength="100"
              placeholder="预计人数或范围"
            />
          </div>
          <div>
            <label for="budget">预算（选填）</label>
            <input
              id="budget"
              name="budget"
              maxlength="100"
              placeholder="预算范围及币种，或尚未确定"
            />
          </div>
        </div>
        <label for="referenceUrl">资料链接（选填）</label>
        <input
          id="referenceUrl"
          name="referenceUrl"
          type="url"
          maxlength="2000"
          placeholder="https://，请确认我们有权限查看"
        />
      </fieldset>
      <label class="consent">
        <input type="checkbox" name="consent" required />{" "}
        <span>
          我同意 Empact 按照<a href="/privacy/">隐私政策</a>处理这次咨询。
        </span>
      </label>
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        class="honeypot"
        aria-hidden="true"
      />
      <input type="hidden" name="idempotencyKey" value="" />
      <p
        class="form-status"
        data-form-status
        role="status"
        aria-live="polite"
        set:text={
          enabled
            ? ""
            : fallback
              ? `线上咨询暂不可用，请通过 ${fallback} 联系我们。`
              : "在线咨询暂不可用，请稍后再试。"
        }
      />
      <button class="button button-primary" type="submit" disabled={!enabled}>
        发送咨询 <span aria-hidden="true">↗</span>
      </button>
    </form>
  </section>
  <section class="section contact-paths">
    <h2>从你的关注出发</h2>
    <a href="/youth/">查看青少年项目 ↗</a>
    <a href="/corporate/">查看企业服务 ↗</a>
    <a href="/school/">查看学校业务 ↗</a>
    <a href="/community/">查看社区业务 ↗</a>
  </section>
  <script>
    import "@/lib/contact-form";
  </script>
</BaseLayout>
