---
import { inquirySegmentsForPages } from "@empact/content/inquiry";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { snapshot, businesses, pages, pageBySlug } from "@/lib/content";
const inquirySegments = inquirySegmentsForPages(pages);
const enabled =
  snapshot.company.contactEnabled &&
  snapshot.company.approved &&
  snapshot.company.privacyApproved &&
  snapshot.mode === "production";
const fallback = snapshot.company.approved ? "enquiries@empact.asia" : "";
const entry = pageBySlug("contact");
---

<BaseLayout title={entry?.title ?? "联系 Empact"} description={entry?.summary}>
  <section class="contact-layout">
    <div class="contact-intro">
      <span class="eyebrow">Start a conversation</span>
      <h1>
        从一次
        <br />
        交流开始
        <span class="contact-period" aria-hidden="true">
          。
        </span>
      </h1>
      <p>{entry?.summary}</p>
      <div class="prose" set:html={entry?.bodyHtml ?? ""} />
      {fallback && (
        <p>
          <a href={`mailto:${fallback}`}>{fallback}</a>
        </p>
      )}
    </div>
    <form
      class="contact-form"
      method="post"
      action="/api/contact"
      data-contact-form
    >
      <h2>咨询与合作</h2>
      <p class="form-help">
        带 * 为必填。留下一个联系方式即可，其余信息可按实际情况补充。
      </p>
      <fieldset>
        <legend>01 / 咨询方向</legend>
        <label for="segment">业务范围 *</label>
        <select id="segment" name="segment" required>
          <option value="">请选择业务范围</option>
          {inquirySegments.map((item) => (
            <option value={item.value}>{item.label}</option>
          ))}
        </select>
        <label for="business">子业务 *</label>
        <select id="business" name="business" required>
          <option value="">请选择子业务</option>
          {inquirySegments
            .filter((item) => item.value !== "other")
            .map((segment) => (
              <optgroup label={segment.label}>
                {businesses
                  .filter((item) => item.segment === segment.value)
                  .map((item) => (
                    <option value={item.id} data-segment={item.segment}>
                      {item.title}
                    </option>
                  ))}
              </optgroup>
            ))}
          <option value="other">其他／暂不确定</option>
        </select>
      </fieldset>
      <fieldset>
        <legend>02 / 联系信息</legend>
        <label for="name">如何称呼您 *</label>
        <input
          id="name"
          name="name"
          required
          maxlength="80"
          autocomplete="name"
          placeholder="姓名或称呼"
        />
        <label for="contact">联系方式 *</label>
        <input
          id="contact"
          name="contact"
          required
          minlength="3"
          maxlength="160"
          placeholder="邮箱、电话或微信号，填写一种即可"
        />
        <label for="organization">机构名称（选填）</label>
        <input
          id="organization"
          name="organization"
          maxlength="160"
          autocomplete="organization"
          placeholder="企业、学校或机构名称"
        />
        <label for="role">职位（选填）</label>
        <input
          id="role"
          name="role"
          maxlength="100"
          autocomplete="organization-title"
        />
      </fieldset>
      <fieldset>
        <legend>03 / 咨询需求</legend>
        <label for="message">咨询需求 *</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="3000"
          placeholder="请用至少 10 个字描述您的咨询需求。"
        ></textarea>
      </fieldset>
      <label class="consent">
        <input type="checkbox" name="consent" required />{" "}
        <span>
          我同意 Empact 按照<a href="/privacy/">隐私政策</a>处理这次咨询。
        </span>
      </label>
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        class="honeypot"
        aria-hidden="true"
      />
      <input type="hidden" name="idempotencyKey" value="" />
      <p
        class="form-status"
        data-form-status
        role="status"
        aria-live="polite"
        set:text={
          enabled
            ? ""
            : fallback
              ? `线上咨询暂不可用，请通过 ${fallback} 联系我们。`
              : "在线咨询暂不可用，请稍后再试。"
        }
      />
      <button class="button button-primary" type="submit" disabled={!enabled}>
        发送咨询 <span aria-hidden="true">↗</span>
      </button>
    </form>
  </section>
  <section class="section contact-paths">
    <h2>从你的关注出发</h2>
    {inquirySegments
      .filter((item) => item.value !== "other")
      .map((item) => (
        <a href={`/${item.value}/`}>查看{item.label} ↗</a>
      ))}
  </section>
  <script>
    import "@/lib/contact-form";
  </script>
</BaseLayout>
