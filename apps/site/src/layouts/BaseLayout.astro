---
import { snapshot, entries, pathFor, isPreviewMode } from "@/lib/content";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  breadcrumbTitle?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  type?: "website" | "article";
}
const {
  title,
  breadcrumbTitle,
  description = snapshot.company.description,
  canonical,
  noIndex = isPreviewMode(),
  type = "website",
} = Astro.props;
const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  "https://empact.cn",
).toString();
const current = entries.find((entry) => pathFor(entry) === Astro.url.pathname);
const ancestors = entries.filter(
  (entry) =>
    entry.kind === "page" &&
    pathFor(entry) !== Astro.url.pathname &&
    Astro.url.pathname.startsWith(pathFor(entry)),
);
const breadcrumb = [...ancestors, ...(current ? [current] : [])].map(
  (entry) => ({
    title: entry.title,
    path: pathFor(entry),
  }),
);
if (!current && breadcrumbTitle)
  breadcrumb.push({ title: breadcrumbTitle, path: Astro.url.pathname });
const jsonLd =
  isPreviewMode() || noIndex
    ? []
    : [
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          name: snapshot.company.name,
          legalName: snapshot.company.legalName,
          url: "https://empact.cn",
          email: snapshot.company.email,
        },
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          name: snapshot.company.name,
          url: "https://empact.cn",
        },
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: breadcrumb.map((entry, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: entry.title,
            item: `https://empact.cn${entry.path}`,
          })),
        },
        ...(type === "article"
          ? [
              {
                "@context": "https://schema.org",
                "@type": "Article",
                headline: title,
                description,
                url: canonicalUrl,
                datePublished: current?.publishedAt,
                publisher: {
                  "@type": "Organization",
                  name: snapshot.company.name,
                },
              },
            ]
          : []),
      ];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={snapshot.company.name} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}｜{snapshot.company.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {jsonLd.map((item) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
      ></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      跳转到正文
    </a>
    {isPreviewMode() && (
      <div class="preview-bar" role="status">
        结构预览｜当前为本机草稿内容，不代表已发布信息
      </div>
    )}
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const animated = new Set<Animation>();
      if ("IntersectionObserver" in window) {
        const star = document.querySelector<SVGElement>(".hero-star");
        if (star) {
          new IntersectionObserver(([entry]) => {
            star.classList.toggle("is-visible", entry.isIntersecting);
          }).observe(star);
        }
        const reveal = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              observer.unobserve(entry.target);
              if (
                reducedMotion.matches ||
                entry.target.contains(document.activeElement)
              )
                return;
              // Only animate content arriving below the first screen; it is visible by default.
              if (
                entry.boundingClientRect.top < 80 ||
                !("animate" in entry.target)
              )
                return;
              const animation = entry.target.animate(
                [
                  { opacity: 0.72, transform: "translateY(1.15rem)" },
                  { opacity: 1, transform: "translateY(0)" },
                ],
                { duration: 900, easing: "ease-out" },
              );
              animated.add(animation);
              animation.onfinish = () => animated.delete(animation);
            });
          },
          { threshold: 0.1 },
        );
        document
          .querySelectorAll(".matrix-column, .case-card, .embedded-item")
          .forEach((element) => reveal.observe(element));
      }
      function finishMotion() {
        animated.forEach((animation) => animation.cancel());
        animated.clear();
      }
      reducedMotion.addEventListener("change", finishMotion);
      document.addEventListener("focusin", finishMotion);
    </script>
  </body>
</html>
