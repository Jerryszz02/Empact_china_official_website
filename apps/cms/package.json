{
  "name": "@empact/cms",
  "private": true,
  "type": "module",
  "exports": {
    "./publisher": "./src/publisher.ts"
  },
  "scripts": {
    "dev": "node run.mjs dev --webpack --hostname 127.0.0.1",
    "build": "node run.mjs build --webpack",
    "start": "node run.mjs start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "create-admin": "node --env-file-if-exists=../../.env --import tsx src/cli/create-admin.ts",
    "rebuild-current": "node --env-file-if-exists=../../.env --import tsx src/cli/rebuild-current.ts",
    "seed:local": "node --env-file-if-exists=../../.env --import tsx src/cli/seed-local.ts",
    "update:experience-content": "node --env-file-if-exists=../../.env --import tsx src/cli/update-experience-content.ts",
    "update:geo-intro-content": "node --env-file-if-exists=../../.env --import tsx src/cli/update-geo-intro-content.ts",
    "migrate:business-content": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate-business-content.ts",
    "reset:business-framework": "node --env-file-if-exists=../../.env --import tsx src/cli/reset-business-framework.ts",
    "generate": "node --env-file-if-exists=../../.env --import tsx payload.mjs generate:types && node --env-file-if-exists=../../.env --import tsx payload.mjs generate:importmap",
    "migrate": "NODE_ENV=production node --env-file-if-exists=../../.env --import tsx payload.mjs migrate",
    "initialize:publication": "node --env-file-if-exists=../../.env --import tsx src/cli/initialize-publication.ts"
  },
  "dependencies": {
    "@empact/content": "*",
    "@payloadcms/db-sqlite": "3.90.1",
    "@payloadcms/drizzle": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/translations": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "cli-color": "2.0.4",
    "graphql": "16.11.0",
    "next": "16.3.4",
    "payload": "3.90.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
