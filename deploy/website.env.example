# Install as /etc/empact/website.env, owner root:empact, chmod 640.
PAYLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CMS_URL=https://empact.cn
SITE_URL=https://empact.cn
DATABASE_URL=file:/srv/empact/data/cms.db
MEDIA_DIR=/srv/empact/data/media
RUNTIME_DIR=/srv/empact/data/site
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=4322
TRUST_PROXY=true
NEXT_TELEMETRY_DISABLED=1
CONTACT_ENABLED=false
CONTACT_RETENTION_DAYS=30
# Enable only once company privacy text and the actual receiver are approved.
# SMTP_HOST=...
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=...
# SMTP_PASS=...
# CONTACT_FROM=...
# CONTACT_TO=...
# CONTACT_RECEIVER_NAME=...
