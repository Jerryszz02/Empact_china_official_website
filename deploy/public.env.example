# /etc/empact/public.env, root:root 0600; systemd reads it before dropping UID.
# Only these values are copied from website.env by the isolation installer.
SITE_URL=https://empact.cn
RUNTIME_DIR=/srv/empact/data/site
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=4322
TRUST_PROXY=true
CONTACT_ENABLED=false
