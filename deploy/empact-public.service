[Unit]
Description=Empact China public website and inquiry receiver
After=network.target

[Service]
Type=simple
User=empact-public
Group=empact-public
WorkingDirectory=/srv/empact/code/current
EnvironmentFile=/etc/empact/public.env
Environment=NODE_ENV=production
Environment=TRUST_PROXY=true
ExecStart=/usr/bin/node --import tsx scripts/public-server.ts
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/empact/data
MemoryMax=512M

[Install]
WantedBy=multi-user.target
